API_BIND_ADDR=127.0.0.1:3000
APP_BASE_URL=http://localhost:5173

# Docker Postgres example.
DATABASE_URL=postgres://icon_set:icon_set_password@127.0.0.1:5432/icon_set
# Homebrew Postgres can usually use your macOS username instead:
# DATABASE_URL=postgres://your-mac-username@127.0.0.1:5432/icon_set

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# GitHub OAuth App callback:
# http://localhost:5173/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret

# Anonymous public demo repository shown on the homepage.
GITHUB_OWNER=your-github-name
GITHUB_REPO=your-demo-icon-repo
GITHUB_BRANCH=main
# Optional token for reading the public demo repository with a higher API rate limit.
GITHUB_TOKEN=
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
MAX_UPLOAD_BYTES=5242880
